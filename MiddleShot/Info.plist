<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>MiddleShot</string>
    <key>CFBundleIdentifier</key>
    <string>app.middleshot</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>MiddleShot</string>
    <key>CFBundleDisplayName</key>
    <string>MiddleShot</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.2.0</string>
    <key>CFBundleVersion</key>
    <string>0</string>
    <key>MSGitCommit</key>
    <string>unknown</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSAccessibilityUsageDescription</key>
    <string>MiddleShot posts synthesized middle-click events and observes mouse clicks to translate multi-finger gestures into middle clicks.</string>
    <key>NSScreenCaptureUsageDescription</key>
    <string>MiddleShot launches the system screenshot tool when you perform the area-screenshot gesture.</string>
    <!-- Silent captures are named and read by MiddleShot itself (to copy them
         to the clipboard), unlike thumbnail mode where screencapture owns the
         file end to end. That first-party access to the screenshot folder is
         what TCC prompts for, so the folders it can plausibly be set to need a
         reason string here. -->
    <key>NSDesktopFolderUsageDescription</key>
    <string>MiddleShot saves your screenshots to the Desktop, and measures this folder when you scan disk usage in the Dashboard.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>MiddleShot saves your screenshots to the folder you chose in the Screenshot app, and measures this folder when you scan disk usage in the Dashboard.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>MiddleShot saves your screenshots to the folder you chose in the Screenshot app, and measures this folder when you scan disk usage in the Dashboard.</string>
    <!-- The Dashboard's disk scan walks the home folder, which reaches into
         cloud-synced folders (Dropbox, iCloud Drive) served by File Provider. -->
    <key>NSFileProviderDomainUsageDescription</key>
    <string>MiddleShot measures how much space synced folders use when you scan disk usage in the Dashboard. It does not read or upload file contents.</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 MiddleShot</string>
</dict>
</plist>
